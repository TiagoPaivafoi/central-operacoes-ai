GEMINI_API_KEY = "cole-aqui-a-chave-do-google-ai-studio"
SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY = "cole-aqui-a-chave-service_role-do-supabase"

# Senha para entrar no painel (mínimo 12 caracteres; use letras, números e símbolos)
APP_PASSWORD = "defina-uma-senha-longa-e-unica"

# Opcional: só para o "modo antigo" de disparo pelo webhook do n8n.
# Use o NOVO token (gere outro no n8n; o antigo ficou exposto no código).
